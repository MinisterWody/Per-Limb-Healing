      private function CreateHitRegion(points:Vector.<Number>, regionName:String) : Sprite
      {
         var hit:Sprite = new Sprite();
         hit.name = regionName;
         hit.mouseChildren = false;
         hit.mouseEnabled = false;
         hit.buttonMode = false;
         hit.useHandCursor = false;
         hit.graphics.beginFill(16777215,0.001);
         hit.graphics.moveTo(points[0],points[1]);
         var i:int = 2;
         while(i < points.length)
         {
            hit.graphics.lineTo(points[i],points[i + 1]);
            i += 2;
         }
         hit.graphics.lineTo(points[0],points[1]);
         hit.graphics.endFill();
         addChild(hit);
         return hit;
      }

      public function GetInteractionHit(limb:int) : Sprite

      private function SetFaceFromHealth(currentHP:Number, maxHP:Number, headCrippled:Boolean, intoxicated:Boolean) : void
      {
         // Classic STATUS face policy: overall HP percentage drives
         // face_00..face_04 in equal 20% bands.  A critically injured player
         // (<=20%) always uses face_04.  Otherwise a crippled head forces
         // face_03, so a crippled head can display only face_03 or face_04.
         // On an uncrippled head, Fallout 4's proven active-alchemy/intoxication
         // flag (HeadFlags bit 0x02) temporarily overrides the ordinary health
         // expression with the classic tongue-out face_10.
         var healthPct:Number = 1.0;
         if(maxHP > 0 && !isNaN(currentHP) && !isNaN(maxHP))
         {
            healthPct = currentHP / maxHP;
         }
         if(healthPct < 0)
         {
            healthPct = 0;
         }
         else if(healthPct > 1)
         {
            healthPct = 1;
         }

         var faceIndex:int;
         if(healthPct <= 0.20)
         {
            faceIndex = 4; // face_04: critical; highest priority
         }
         else if(headCrippled)
         {
            faceIndex = 3; // face_03: crippled head minimum / only noncritical state
         }
         else if(intoxicated)
         {
            faceIndex = 5; // face_10: classic intoxicated expression
         }
         else if(healthPct <= 0.40)
         {
            faceIndex = 3; // face_03
         }
         else if(healthPct <= 0.60)
         {
            faceIndex = 2; // face_02
         }
         else if(healthPct <= 0.80)
         {
            faceIndex = 1; // face_01
         }
         else
         {
            faceIndex = 0; // face_00
         }

         for(var i:int = 0; i < this._Faces.length; ++i)
         {
            this._Faces[i].visible = i == faceIndex;
         }
      }


            case this.LIMB_TORSO:
               return this._TorsoHit;
            case this.LIMB_LEFT_ARM:
               return this._LeftArmHit;
            case this.LIMB_RIGHT_ARM:
               return this._RightArmHit;
            case this.LIMB_LEFT_LEG:
               return this._LeftLegHit;
            case this.LIMB_RIGHT_LEG:
               return this._RightLegHit;
         }
         return null;
      }

      public function SetHoveredLimb(limb:int) : void
      {
         if(limb == this._HoveredLimb)
         {
            return;
         }
         if(this._HoveredLimb != this.LIMB_NONE)
         {
            this.ApplyLimbAlpha(this._HoveredLimb,1.0);
         }
         removeEventListener(Event.ENTER_FRAME,this.onPulseFrame);
         this._HoveredLimb = limb;
         this._PulsePhase = 0.0;
         if(this._HoveredLimb != this.LIMB_NONE)
         {
            this.ApplyLimbAlpha(this._HoveredLimb,1.0);
            addEventListener(Event.ENTER_FRAME,this.onPulseFrame);
         }
      }

      private function onPulseFrame(event:Event) : void
      {
         this._PulsePhase += 0.28;
         var pulse:Number = 0.55 + 0.45 * (0.5 + 0.5 * Math.cos(this._PulsePhase));
         this.ApplyLimbAlpha(this._HoveredLimb,pulse);
      }

      private function ApplyLimbAlpha(limb:int, value:Number) : void
      {
         switch(limb)
         {
            case this.LIMB_HEAD:
               this._HeadNormal.alpha = value;
               this._HeadBroken.alpha = value;
               for each(var face:Sprite in this._Faces)
               {
                  face.alpha = value;
               }
               break;
            case this.LIMB_TORSO:
               this._TorsoNormal.alpha = value;
               this._TorsoBroken.alpha = value;
               break;
            case this.LIMB_LEFT_ARM:
               this._LeftArmNormal.alpha = value;
               this._LeftArmBroken.alpha = value;
               break;
            case this.LIMB_RIGHT_ARM:
               this._RightArmNormal.alpha = value;
               this._RightArmBroken.alpha = value;
               break;
            case this.LIMB_LEFT_LEG:
               this._LeftLegNormal.alpha = value;
               this._LeftLegBroken.alpha = value;
               break;
            case this.LIMB_RIGHT_LEG:
               this._RightLegNormal.alpha = value;
               this._RightLegBroken.alpha = value;
               break;
         }
      }

